# Environment: dev (LocalStack + local Docker DB)
APP_ENV=dev
APP_NAME="DocuSpace API"
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg://docuspace:docuspace@localhost:5432/docuspace

# JWT settings
JWT_SECRET=dev-secret-key-change-in-production-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# S3 / LocalStack storage
STORAGE_BACKEND=s3
S3_BUCKET=docuspace-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack Auth Token
LOCALSTACK_AUTH_TOKEN=

# Upload size limits
MAX_FILE_SIZE_BYTES=10485760
MAX_PROJECT_SIZE_BYTES=104857600
