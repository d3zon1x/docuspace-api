# Application name
APP_NAME="DocuSpace API"

# Debug mode
DEBUG=true

# Log level
LOG_LEVEL=INFO

# Public base URL used in verification and invitation links
PUBLIC_BASE_URL=http://localhost:8000

# PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg://docuspace:docuspace@localhost:5432/docuspace

# JWT settings (1 hour = 3600s)
JWT_SECRET=dev-secret-key-change-in-production-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600
EMAIL_TOKEN_EXPIRY_SECONDS=86400

# SMTP settings (Mailpit on port 1025 locally; AWS SES in production)
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@docuspace.local
