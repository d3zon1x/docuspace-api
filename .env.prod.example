APP_ENV=prod
APP_NAME="DocuSpace API"
DEBUG=false
LOG_LEVEL=INFO

# AWS RDS PostgreSQL
DATABASE_URL=postgresql+psycopg://docuspace:CHANGE_ME_RDS_PASSWORD@docuspace-db.xxxx.eu-central-1.rds.amazonaws.com:5432/docuspace

# JWT settings
JWT_SECRET=CHANGE_ME_STRONG_PRODUCTION_JWT_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# AWS S3
STORAGE_BACKEND=s3
S3_BUCKET=docuspace-documents-prod
S3_REGION=eu-central-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upload size limits
MAX_FILE_SIZE_BYTES=10485760
MAX_PROJECT_SIZE_BYTES=104857600
